{% extends 'base.html.twig' %}

{% block title %}Espace Employé{% endblock %}

{% block body %}
    <section class="worker-page">
        <div class="container">
            <h1 class="worker-title">Espace Employé</h1>

            <nav class="worker-tabs" aria-label="Navigation employé">
                <a class="worker-tab {{ activeTab == 'orders' ? 'is-active' : '' }}"
                   href="{{ path('app_worker_dashboard', { tab: 'orders' }) }}">
                    <i class="bi bi-box-seam"></i>
                    Commandes
                </a>
                <a class="worker-tab {{ activeTab == 'menus' ? 'is-active' : '' }}"
                   href="{{ path('app_worker_dashboard', { tab: 'menus' }) }}">
                    <i class="bi bi-egg-fried"></i>
                    Menus
                </a>
                <a class="worker-tab {{ activeTab == 'reviews' ? 'is-active' : '' }}"
                   href="{{ path('app_worker_dashboard', { tab: 'reviews' }) }}">
                    <i class="bi bi-star"></i>
                    Avis ({{ pendingReviews|length }})
                </a>
            </nav>

            <div class="worker-content">
                {% if activeTab == 'orders' %}
                    <div class="worker-section-header">
                        <h2 class="worker-section-title">Gestion des commandes ({{ orders|length }})</h2>
                    </div>

                    {% if orders is empty %}
                        <div class="worker-card worker-empty">
                            <div class="worker-empty__icon"><i class="bi bi-check-circle"></i></div>
                            <p class="mb-0">Aucune commande à traiter pour le moment.</p>
                        </div>
                    {% else %}
                        <div class="worker-stack">
                            {% for order in orders %}
                                {% set orderMenu = order.customerOrderMenus|first %}
                                {% set menuTitle = orderMenu and orderMenu.menu ? orderMenu.menu.title : 'Menu' %}
                                {% set statusHistory = order.customerOrderStatusHistories|last %}
                                {% set statusLabel = statusHistory and statusHistory.orderStatus ? statusHistory.orderStatus.label : 'Terminée' %}

                                <article class="worker-card worker-order">
                                    <div class="worker-order__header">
                                        <div class="worker-order__main">
                                            <div class="worker-order__title-row">
                                                <h3 class="worker-order__title">{{ menuTitle }}</h3>
                                                <span class="worker-status">{{ statusLabel }}</span>
                                            </div>
                                            <p class="worker-order__subtitle">
                                                {% if order.user %}
                                                    Client : {{ order.user.firstName }} {{ order.user.lastName }}
                                                    ({{ order.user.email }})
                                                {% endif %}
                                            </p>
                                        </div>
                                        <div class="worker-order__select">
                                            <label class="worker-meta__label" for="status-{{ order.id }}">Changer le statut</label>
                                            <select id="status-{{ order.id }}" class="form-select worker-select">
                                                {% if orderStatuses is empty %}
                                                    <option selected>Terminée</option>
                                                {% else %}
                                                    {% for status in orderStatuses %}
                                                        <option value="{{ status.id }}"
                                                            {{ statusHistory and statusHistory.orderStatus and statusHistory.orderStatus.id == status.id ? 'selected' : '' }}>
                                                            {{ status.label }}
                                                        </option>
                                                    {% endfor %}
                                                {% endif %}
                                            </select>
                                        </div>
                                    </div>

                                    <div class="worker-order__meta">
                                        <div class="worker-meta">
                                            <div class="worker-meta__label">Date</div>
                                            <div class="worker-meta__value">
                                                {{ order.serviceDate ? order.serviceDate|date('d/m/Y') : '-' }}
                                            </div>
                                        </div>
                                        <div class="worker-meta">
                                            <div class="worker-meta__label">Heure</div>
                                            <div class="worker-meta__value">{{ order.serviceTime ?: '-' }}</div>
                                        </div>
                                        <div class="worker-meta">
                                            <div class="worker-meta__label">Personnes</div>
                                            <div class="worker-meta__value">{{ order.peopleCount ?: '-' }}</div>
                                        </div>
                                        <div class="worker-meta">
                                            <div class="worker-meta__label">Total</div>
                                            <div class="worker-meta__value worker-meta__value--total">
                                                {% if order.totalPrice is not null %}
                                                    {% set totalDisplay = order.totalPrice / 100 %}
                                                    {{ totalDisplay|number_format(2, ',', ' ') }} €
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="worker-order__address">
                                        <div class="worker-meta__label">Adresse de livraison</div>
                                        <div class="worker-meta__value">
                                            {% if order.deliveryAddress %}
                                                {{ order.deliveryAddress }},
                                                {{ order.deliveryPostalCode }}
                                                {{ order.deliveryCity }}
                                            {% else %}
                                                -
                                            {% endif %}
                                        </div>
                                    </div>

                                </article>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% elseif activeTab == 'menus' %}
                    <div class="worker-section-header">
                        <h2 class="worker-section-title">Gestion des menus ({{ menus|length }})</h2>
                        <a class="btn btn-success worker-action" href="{{ path('app_underconstruct') }}">
                            <i class="bi bi-plus-lg"></i>
                            Nouveau menu
                        </a>
                    </div>

                    {% if menus is empty %}
                        <div class="worker-card worker-empty">
                            <div class="worker-empty__icon"><i class="bi bi-check-circle"></i></div>
                            <p class="mb-0">Aucun menu disponible.</p>
                        </div>
                    {% else %}
                        <div class="row g-4">
                            {% for menu in menus %}
                                <div class="col-12 col-md-6 col-lg-4">
                                    <article class="worker-card worker-menu">
                                        <div class="worker-menu__media">
                                            {% if menu.media and menu.media.imgUrl %}
                                                <img src="{{ menu.media.imgUrl }}" alt="{{ menu.media.altText ?: menu.title }}">
                                            {% else %}
                                                <img src="{{ asset('build/images/menus/menus-asia.jpg') }}" alt="{{ menu.title }}">
                                            {% endif %}
                                        </div>
                                        <div class="worker-menu__body">
                                            <div class="worker-menu__header">
                                                <h3 class="worker-menu__title">{{ menu.title }}</h3>
                                                <span class="worker-badge {{ menu.active ? 'worker-badge--active' : 'worker-badge--inactive' }}">
                                                    {{ menu.active ? 'Actif' : 'Inactif' }}
                                                </span>
                                            </div>
                                            <p class="worker-menu__text">{{ menu.description ?: 'Description à compléter.' }}</p>
                                            <div class="worker-menu__meta">
                                                <span>
                                                    {% set priceDisplay = menu.basePrice / 100 %}
                                                    {{ priceDisplay|number_format(2, ',', ' ') }} €/pers
                                                </span>
                                                <span>Min. {{ menu.minPeople }} pers.</span>
                                            </div>
                                        </div>
                                        <div class="worker-menu__actions">
                                            <a class="btn btn-outline-success w-100" href="{{ path('app_underconstruct') }}">
                                                <i class="bi bi-pencil"></i>
                                                Modifier
                                            </a>
                                            <button class="btn btn-outline-danger worker-icon-btn" type="button" aria-label="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </article>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% else %}
                    <div class="worker-section-header">
                        <h2 class="worker-section-title">Validation des avis</h2>
                    </div>

                    <div class="worker-subtitle">En attente de validation ({{ pendingReviews|length }})</div>

                    {% if pendingReviews is empty %}
                        <div class="worker-card worker-empty">
                            <div class="worker-empty__icon"><i class="bi bi-check-circle"></i></div>
                            <p class="mb-0">Tous les avis ont été traités</p>
                        </div>
                    {% else %}
                        <div class="worker-stack">
                            {% for review in pendingReviews %}
                                {% set pendingMenu = review.customerOrderMenus|first %}
                                {% set pendingMenuTitle = pendingMenu and pendingMenu.menu ? pendingMenu.menu.title : 'Menu' %}
                                {% set rating = review.rating > 5 ? 5 : review.rating %}
                                <article class="worker-card worker-review">
                                    <div class="worker-review__header">
                                        <div>
                                            <h3 class="worker-review__title">{{ pendingMenuTitle }}</h3>
                                            <p class="worker-review__subtitle">
                                                Par {{ review.user ? review.user.firstName ~ ' ' ~ review.user.lastName : 'Client' }}
                                            </p>
                                        </div>
                                        <div class="worker-review__actions">
                                            <button class="btn btn-outline-success btn-sm" type="button">Valider</button>
                                            <button class="btn btn-outline-danger btn-sm" type="button">Refuser</button>
                                        </div>
                                    </div>
                                    <div class="worker-review__stars">
                                        {% for i in 1..5 %}
                                            {% if i <= rating %}
                                                <i class="bi bi-star-fill"></i>
                                            {% else %}
                                                <i class="bi bi-star"></i>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                    <p class="worker-review__text">{{ review.description ?: 'Avis en attente.' }}</p>
                                </article>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <div class="worker-subtitle mt-4">Avis publiés ({{ publishedReviews|length }})</div>
                    {% if publishedReviews is empty %}
                        <div class="worker-card worker-empty">
                            <div class="worker-empty__icon"><i class="bi bi-check-circle"></i></div>
                            <p class="mb-0">Aucun avis publié pour le moment.</p>
                        </div>
                    {% else %}
                        <div class="worker-stack">
                            {% for review in publishedReviews %}
                                {% set publishedMenu = review.customerOrderMenus|first %}
                                {% set publishedMenuTitle = publishedMenu and publishedMenu.menu ? publishedMenu.menu.title : 'Menu' %}
                                {% set rating = review.rating > 5 ? 5 : review.rating %}

                                <article class="worker-card worker-review">
                                    <div class="worker-review__header">
                                        <div>
                                            <h3 class="worker-review__title">{{ publishedMenuTitle }}</h3>
                                            <p class="worker-review__subtitle">
                                                Par {{ review.user ? review.user.firstName ~ ' ' ~ review.user.lastName : 'Client' }}
                                            </p>
                                        </div>
                                        <div class="worker-review__status">
                                            <div class="worker-review__stars worker-review__stars--inline">
                                                {% for i in 1..5 %}
                                                    {% if i <= rating %}
                                                        <i class="bi bi-star-fill"></i>
                                                    {% else %}
                                                        <i class="bi bi-star"></i>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                            <i class="bi bi-check-circle"></i>
                                        </div>
                                    </div>
                                    <p class="worker-review__text">{{ review.description ?: 'Avis publié.' }}</p>
                                </article>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
