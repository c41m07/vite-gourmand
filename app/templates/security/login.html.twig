{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <section class="auth-page">
        <div class="container">
            <h1 class="auth-title">Connexion</h1>

            <div class="auth-card">
                <form method="post" class="auth-form" data-demo-login-form>
                    {% if error %}
                        <div class="alert alert-danger mb-0">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    {% if app.user %}
                        <div class="alert alert-success mb-0">
                            Vous êtes connecté en tant que {{ app.user.userIdentifier }},
                            <a href="{{ logout_path() }}">se déconnecter</a>.
                        </div>
                    {% endif %}

                    <div class="auth-field">
                        <label for="username" class="form-label">
                            Email <span class="text-danger fw-bold" aria-hidden="true">*</span>
                            <span class="visually-hidden">champ obligatoire</span>
                        </label>
                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            class="form-control auth-input"
                            placeholder="votre.email@example.com"
                            autocomplete="email"
                            required
                            autofocus
                        >
                    </div>

                    <div class="auth-field">
                        <label for="password" class="form-label">
                            Mot de passe <span class="text-danger fw-bold" aria-hidden="true">*</span>
                            <span class="visually-hidden">champ obligatoire</span>
                        </label>
                        <div class="auth-input-wrapper">
                            <input
                                type="password"
                                name="_password"
                                id="password"
                                class="form-control auth-input"
                                placeholder="********"
                                autocomplete="current-password"
                                required
                            >
                            <i class="bi bi-eye auth-password__icon" aria-hidden="true"></i>
                        </div>
                    </div>

                    <div class="auth-options">
                        <label class="auth-check" for="_remember_me">
                            <input type="checkbox" name="_remember_me" id="_remember_me" class="auth-check__input">
                            <span class="auth-check__box" aria-hidden="true"></span>
                            <span class="auth-check__label">Se souvenir de moi</span>
                        </label>
                        <div class="auth-forgot">
                            <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button class="auth-btn" type="submit">
                        Se connecter
                    </button>

                    <div class="auth-divider">ou</div>

                    <div class="auth-footer">
                        <span>Vous n'avez pas encore de compte ?</span>
                        <a class="auth-btn auth-btn--outline" href="{{ path('app_register') }}">Créer un compte</a>
                    </div>
                </form>
            </div>

            {# TODO: A SUPPRIMER EN PROD #}
            <section class="auth-demo" data-demo-login-root aria-labelledby="auth-demo-title">
                <h2 id="auth-demo-title" class="auth-demo__title">Comptes de démonstration</h2>

                <div class="auth-demo__group">
                    <p class="mb-1"><strong>Utilisateur</strong></p>
                    <p class="mb-1">Email : test@test.fr</p>
                    <p class="mb-2">Mot de passe : Admin1234*/</p>
                    <button
                        type="button"
                        class="auth-demo__fill"
                        data-demo-login-fill
                        data-demo-email="test@test.fr"
                        data-demo-password="Admin1234*/"
                    >
                        Remplir automatiquement
                    </button>
                </div>

                <div class="auth-demo__group">
                    <p class="mb-1"><strong>Employé</strong></p>
                    <p class="mb-1">Email : worker@test.fr</p>
                    <p class="mb-2">Mot de passe : Admin1234*/</p>
                    <button
                        type="button"
                        class="auth-demo__fill"
                        data-demo-login-fill
                        data-demo-email="worker@test.fr"
                        data-demo-password="Admin1234*/"
                    >
                        Remplir automatiquement
                    </button>
                </div>

                <div class="auth-demo__group auth-demo__group--last">
                    <p class="mb-1"><strong>Admin</strong></p>
                    <p class="mb-1">Email : admin@test.fr</p>
                    <p class="mb-2">Mot de passe : Admin1234*/</p>
                    <button
                        type="button"
                        class="auth-demo__fill"
                        data-demo-login-fill
                        data-demo-email="admin@test.fr"
                        data-demo-password="Admin1234*/"
                    >
                        Remplir automatiquement
                    </button>
                </div>
            </section>
        </div>
    </section>
{% endblock %}
