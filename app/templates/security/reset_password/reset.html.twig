{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
    <section class="auth-page">
        <div class="container">
            <div class="auth-header-icon" aria-hidden="true">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="auth-title">Nouveau mot de passe</h1>
            <p class="auth-subtitle">
                Définissez un nouveau mot de passe sécurisé pour votre compte.
            </p>

            <div class="auth-card">
                {{ form_start(resetForm, { attr: { class: 'auth-form' } }) }}
                    {{ form_errors(resetForm) }}

                    <div class="auth-field">
                        <label for="{{ resetForm.plainPassword.first.vars.id }}" class="form-label">
                            Nouveau mot de passe <span class="text-danger fw-bold" aria-hidden="true">*</span>
                            <span class="visually-hidden">champ obligatoire</span>
                        </label>
                        {{ form_widget(resetForm.plainPassword.first, { attr: { class: 'form-control auth-input', placeholder: '********', autocomplete: 'new-password' } }) }}
                        {{ form_errors(resetForm.plainPassword.first) }}
                    </div>

                    <div class="auth-field">
                        <label for="{{ resetForm.plainPassword.second.vars.id }}" class="form-label">
                            Confirmer le mot de passe <span class="text-danger fw-bold" aria-hidden="true">*</span>
                            <span class="visually-hidden">champ obligatoire</span>
                        </label>
                        {{ form_widget(resetForm.plainPassword.second, { attr: { class: 'form-control auth-input', placeholder: '********', autocomplete: 'new-password' } }) }}
                        {{ form_errors(resetForm.plainPassword.second) }}
                    </div>

                    <button class="auth-btn" type="submit">Confirmer</button>

                    <div class="auth-footer auth-footer--compact">
                        <a class="auth-link-inline" href="{{ path('app_login') }}">Retour à la connexion</a>
                    </div>
                {{ form_end(resetForm) }}
            </div>
        </div>
    </section>
{% endblock %}
