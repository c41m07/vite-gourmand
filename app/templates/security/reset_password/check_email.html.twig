{% extends 'base.html.twig' %}

{% block title %}Email de réinitialisation envoyé{% endblock %}

{% block body %}
    <section class="status-page status-page--center">
        <div class="container">
            <article class="status-card status-card--compact">
                <div class="status-icon status-icon--success" aria-hidden="true">
                    <i class="bi bi-check2"></i>
                </div>

                <h1 class="status-title">Email envoyé !</h1>

                <p class="status-text">
                    Si un compte correspond à votre adresse email, un lien de réinitialisation vient d'être envoyé.
                </p>
                <p class="status-text status-text--muted">
                    Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                </p>

                <div class="status-actions">
                    <a class="auth-btn" href="{{ path('app_login') }}">Retour à la connexion</a>
                    <a class="status-link" href="{{ path('app_forgot_password_request') }}">Renvoyer un lien</a>
                </div>
            </article>
        </div>
    </section>
{% endblock %}
