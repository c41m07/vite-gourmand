{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
    <section class="auth-page">
        <div class="container">
            <div class="auth-header-icon" aria-hidden="true">
                <i class="bi bi-envelope"></i>
            </div>
            <h1 class="auth-title">Mot de passe oublié ?</h1>
            <p class="auth-subtitle">
                Entrez votre adresse email et nous vous enverrons un lien pour réinitialiser votre mot de passe.
            </p>

            <div class="auth-card">
                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="alert alert-danger mb-0" role="alert">{{ flash_error }}</div>
                {% endfor %}

                {{ form_start(requestForm, { attr: { class: 'auth-form' } }) }}
                <div class="auth-field">
                    <label for="{{ requestForm.email.vars.id }}" class="form-label">
                        Adresse email <span class="text-danger fw-bold" aria-hidden="true">*</span>
                        <span class="visually-hidden">champ obligatoire</span>
                    </label>
                    {{ form_widget(requestForm.email, { attr: { class: 'form-control auth-input', placeholder: 'votre.email@example.com', autofocus: true } }) }}
                    {{ form_errors(requestForm.email) }}
                </div>

                <button class="auth-btn" type="submit">Envoyer le lien de réinitialisation</button>

                <div class="auth-footer auth-footer--compact">
                    <a class="auth-link-inline" href="{{ path('app_login') }}">Retour à la connexion</a>
                    <span>Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a></span>
                </div>
                {{ form_end(requestForm) }}
            </div>
        </div>
    </section>
{% endblock %}
