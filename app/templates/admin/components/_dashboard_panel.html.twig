<div class="admin-metrics">
    <article class="admin-card admin-metric">
        <div class="admin-metric__icon admin-metric__icon--blue">
            <i class="bi bi-box-seam"></i>
        </div>
        <div class="admin-metric__label">Total des commandes</div>
        <div class="admin-metric__value">{{ dashboard.totalOrders }}</div>
    </article>
    <article class="admin-card admin-metric">
        <div class="admin-metric__icon admin-metric__icon--orange">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <div class="admin-metric__label">Commandes en cours</div>
        <div class="admin-metric__value">{{ dashboard.ordersInProgress }}</div>
    </article>
    <article class="admin-card admin-metric">
        <div class="admin-metric__icon admin-metric__icon--green">
            <i class="bi bi-currency-euro"></i>
        </div>
        <div class="admin-metric__label">Chiffre d'affaires</div>
        <div class="admin-metric__value">{{ dashboard.revenueTotal|price_cents('0 €') }}</div>
    </article>
    <article class="admin-card admin-metric">
        <div class="admin-metric__icon admin-metric__icon--gold">
            <i class="bi bi-star"></i>
        </div>
        <div class="admin-metric__label">Moyenne des avis</div>
        <div class="admin-metric__value">{{ dashboard.avgRating|number_format(1, ',', ' ') }}/5</div>
    </article>
    <article class="admin-card admin-metric">
        <div class="admin-metric__icon admin-metric__icon--purple">
            <i class="bi bi-people"></i>
        </div>
        <div class="admin-metric__label">Clients</div>
        <div class="admin-metric__value">{{ dashboard.clientsCount }}</div>
    </article>
    <article class="admin-card admin-metric">
        <div class="admin-metric__icon admin-metric__icon--teal">
            <i class="bi bi-egg-fried"></i>
        </div>
        <div class="admin-metric__label">Menus actifs</div>
        <div class="admin-metric__value">{{ dashboard.activeMenus }}</div>
    </article>
</div>

<h2 class="admin-section-title mt-4">Commandes récentes</h2>
<div class="admin-card admin-orders-card">
    {% if dashboard.recentOrders is empty %}
        <p class="text-muted mb-0">Aucune commande récente.</p>
    {% else %}
        {% for order in dashboard.recentOrders %}
            <div class="admin-order-row">
                <div>
                    <div class="admin-order__title">{{ order.primaryMenuTitle }}</div>
                    <div class="admin-order__meta">
                        {% if order.user %}
                            {{ order.user.firstName }} {{ order.user.lastName }} ·
                        {% endif %}
                        {{ order.peopleCount ?: '-' }} pers. ·
                        {{ order.serviceDate ? order.serviceDate|date('d/m/Y') : '-' }}
                    </div>
                </div>
                <div class="admin-order__actions">
                    <div class="admin-order__price">{{ order.totalPrice|price_cents }}</div>
                    <span class="admin-status admin-status--pill">{{ order.currentStatusCode ? order.currentStatusLabel : 'Terminée' }}</span>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
