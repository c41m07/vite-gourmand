{% extends 'base.html.twig' %}

{% block title %}Espace Admin{% endblock %}

{% block body %}
    <section class="admin-page">
        <div class="container">
            <h1 class="admin-title">Espace Admin</h1>

            {% include 'admin/components/_tabs.html.twig' with {
                activeTab: viewData.activeTab,
                employees: viewData.employees
            } %}

            <div class="admin-content">
                {% if viewData.activeTab == 'employees' %}
                    {% include 'admin/components/_employees_panel.html.twig' with {
                        employees: viewData.employees
                    } %}
                {% else %}
                    {% include 'admin/components/_dashboard_panel.html.twig' with {
                        dashboard: viewData
                    } %}
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
