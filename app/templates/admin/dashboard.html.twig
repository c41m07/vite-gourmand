{% extends 'base.html.twig' %}

{% block title %}Espace Admin{% endblock %}

{% block body %}
    <section class="admin-page">
        <div class="container">
            <h1 class="admin-title">Espace Admin</h1>

            {% include 'admin/components/_tabs.html.twig' with { activeTab: activeTab, employees: employees } %}

            <div class="admin-content">
                {% if activeTab == 'employees' %}
                    {% include 'admin/components/_employees_panel.html.twig' with { employees: employees } %}
                {% else %}
                    {% include 'admin/components/_dashboard_panel.html.twig' with {
                        orders: orders,
                        ordersInProgress: ordersInProgress,
                        revenueTotal: revenueTotal,
                        avgRating: avgRating,
                        clientsCount: clientsCount,
                        activeMenus: activeMenus
                    } %}
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
