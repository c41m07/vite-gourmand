{% extends 'base.html.twig' %}

{% block title %}Échec d'envoi du message{% endblock %}

{% block body %}
    {% include 'components/hero.html.twig' with {
        'title': 'Message non envoyé',
        'subtitle': 'Une erreur est survenue lors de l\'envoi de votre message. Veuillez réessayer plus tard.',
        'background': '#5a2a2a'
    } %}

    <section class="py-5" aria-labelledby="underconstruct-title">
        <div class="container">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    <h2 id="underconstruct-title" class="h3 fw-bold mb-3">Une erreur est survenue</h2>
                    <p class="text-muted mb-4">
                        Votre message n'a pas été envoyé. Nous mettons tout en œuvre pour résoudre ce problème dans les plus brefs délais.
                    </p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a class="btn btn-primary px-4" href="{{ path('app_home') }}">Retour à l'accueil</a>
                        <a class="btn btn-outline-secondary px-4" href="{{ path('app_contact_index') }}">Nous contacter</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
