{% extends 'base.html.twig' %}

{% block title %}Message envoyé{% endblock %}

{% block body %}
    <section class="status-page status-page--center" aria-labelledby="contact-success-title">
        <div class="container">
            <article class="status-card status-card--compact">
                <div class="status-icon status-icon--success" aria-hidden="true">
                    <i class="bi bi-check2"></i>
                </div>

                <h1 id="contact-success-title" class="status-title">Message envoyé !</h1>

                <p class="status-text">
                    Merci pour votre message.
                </p>
                <p class="status-text status-text--muted">
                        Votre message a bien été envoyé. Nous mettons tout en œuvre pour vous répondre dans les plus brefs délais.
                </p>

                <div class="status-actions">
                    <a class="auth-btn" href="{{ path('app_home') }}">Retour à l'accueil</a>
                    <a class="status-link" href="{{ path('app_contact_index') }}">Envoyer un autre message</a>
                </div>
            </article>
        </div>
    </section>
{% endblock %}
