{% set ordersCount = orders|length %}
<h2 class="account-section-title">Mes commandes ({{ ordersCount }})</h2>

{% if orderStatusFilters is defined and orderStatusFilters|length > 1 %}
    <nav class="account-filters" aria-label="Filtrer les commandes par statut">
        {% for statusCode, statusFilter in orderStatusFilters %}
            <a
                class="account-filter {{ orderStatusFilter == statusCode ? 'is-active' : '' }}"
                href="{{ path('app_user_profile', {tab: 'orders', status: statusCode}) }}"
            >
                <span>{{ statusFilter.label }}</span>
                <span class="account-filter__count">{{ statusFilter.count }}</span>
            </a>
        {% endfor %}
    </nav>
{% endif %}

{% if ordersCount == 0 %}
    <div class="account-card account-empty">
        <p class="mb-3">Aucune commande pour le moment.</p>
        <a class="btn btn-outline-primary px-4" href="{{ path('app_menu_index') }}">
            Voir les menus
        </a>
    </div>
{% else %}
    <div class="account-stack">
        {% for order in orders %}
            <article class="account-card account-order">
                <div class="account-order__header">
                    <div>
                        <h3 class="account-order__title">{{ order.primaryMenuTitle }}</h3>
                        <p class="account-order__subtitle">Commande n° CMD-{{ order.id }}</p>
                    </div>
                    <span class="account-status">{{ order.currentStatusLabel }}</span>
                </div>

                <div class="account-meta">
                    <div class="account-meta__item">
                        <div class="account-meta__label">Date de prestation</div>
                        <div class="account-meta__value">
                            {% if order.serviceDate %}
                                {{ order.serviceDate|date('d/m/Y') }}{% if order.serviceTime %} à {{ order.serviceTime }}{% endif %}
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </div>
                    <div class="account-meta__item">
                        <div class="account-meta__label">Nombre de personnes</div>
                        <div class="account-meta__value">
                            {{ order.peopleCount ?: '-' }}
                        </div>
                    </div>
                    <div class="account-meta__item">
                        <div class="account-meta__label">Total</div>
                        <div class="account-meta__value account-meta__value--total">
                            {{ order.totalPrice|price_cents }}
                        </div>
                    </div>
                </div>

                <div class="account-address">
                    <div class="account-meta__label">Adresse de livraison</div>
                    <div class="account-meta__value">
                        {% include 'shared/order/_delivery_address.html.twig' with {order: order} only %}
                    </div>
                </div>
                <div class="mt-4 d-flex justify-content-end">
                    <a class="btn btn-outline-success" href="{{ path('app_user_order_show', {'id': order.id}) }}">
                        Voir la commande
                    </a>
                </div>
            </article>
        {% endfor %}
    </div>
{% endif %}
