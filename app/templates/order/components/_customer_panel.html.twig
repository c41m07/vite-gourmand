<article class="order-entry__panel">
    <details class="order-entry__details">
        <summary class="order-entry__summary-toggle">
            <span>
                <span class="order-entry__eyebrow">Profil client</span>
                <span class="order-entry__section-title order-entry__section-title--summary">Vos informations</span>
            </span>
            <i class="bi bi-chevron-down order-entry__summary-chevron" aria-hidden="true"></i>
        </summary>

        <div class="order-entry__customer-grid">
            <div class="order-entry__customer-card">
                <span class="order-entry__customer-label">Nom</span>
                <strong class="order-entry__customer-value">{{ customer.lastName }}</strong>
            </div>
            <div class="order-entry__customer-card">
                <span class="order-entry__customer-label">Prénom</span>
                <strong class="order-entry__customer-value">{{ customer.firstName }}</strong>
            </div>
            <div class="order-entry__customer-card">
                <span class="order-entry__customer-label">Email</span>
                <strong class="order-entry__customer-value">{{ customer.email }}</strong>
            </div>
            <div class="order-entry__customer-card">
                <span class="order-entry__customer-label">Téléphone du compte</span>
                <strong class="order-entry__customer-value">{{ customer.phone ?: '-' }}</strong>
            </div>
        </div>
    </details>
</article>
