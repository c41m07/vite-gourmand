{% extends 'base.html.twig' %}

{% block title %}Commander {{ menu.title }}{% endblock %}

{% block body %}
    {% set preview_people = orderPreview is not null and orderPreview.peopleCount is defined ? orderPreview.peopleCount : menu.minPeople %}
    {% set preview_subtotal = orderPreview is not null and orderPreview.menuSubtotal is defined ? orderPreview.menuSubtotal : (menu.basePrice * preview_people) %}
    {% set preview_discount = orderPreview is not null and orderPreview.discountAmount is defined ? orderPreview.discountAmount : 0 %}
    {% set preview_delivery = orderPreview is not null and orderPreview.deliveryPrice is defined ? orderPreview.deliveryPrice : 0 %}
    {% set preview_total = orderPreview is not null and orderPreview.totalPrice is defined ? orderPreview.totalPrice : (preview_subtotal - preview_discount + preview_delivery) %}
    {% set discount_active = preview_discount > 0 %}

    {% include 'components/_hero.html.twig' with {
        title: 'Commander ' ~ menu.title,
        asset_url: menu.media ? menu.media.imgUrl : null,
        subtitle: menu.basePrice|price_cents ~ ' par personne'
    } %}

    <section
        class="order-entry py-5"
        {{ stimulus_controller('order-preview', {
            basePrice: menu.basePrice ?? 0,
            minPeople: menu.minPeople ?? 0
        }) }}
    >
        <div class="container">
            <div class="order-entry__topbar">
                <a href="{{ path('app_menu_show', {id: menu.id}) }}" class="order-entry__back">
                    <i class="bi bi-arrow-left me-2"></i>Retour au menu
                </a>
            </div>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger order-entry__flash" role="alert">{{ message }}</div>
            {% endfor %}

            <div
                class="order-entry__layout{{ orderPreview is not null ? ' order-entry__layout--preview' : '' }}"
                data-order-preview-target="layout"
            >
                <div class="order-entry__main">
                    {% include 'order/components/_selected_menu_panel.html.twig' with {
                        menu: menu
                    } only %}

                    {% include 'order/components/_customer_panel.html.twig' with {
                        customer: app.user
                    } only %}

                    {% if orderPreview is not null %}
                        {% include 'order/components/_preview_panel.html.twig' with {
                            orderPreview: orderPreview
                        } only %}
                    {% endif %}

                    {% include 'order/components/_form_panel.html.twig' with {
                        orderForm: orderForm,
                        menu: menu,
                        discount_active: discount_active,
                        orderPreview: orderPreview
                    } only %}
                </div>

                <aside
                    class="order-entry__sidebar{{ orderPreview is not null ? ' d-none' : '' }}"
                    data-order-preview-target="sidebar"
                >
                    {% include 'order/components/_summary_sidebar.html.twig' with {
                        menu: menu,
                        preview_people: preview_people,
                        preview_subtotal: preview_subtotal,
                        preview_discount: preview_discount,
                        preview_delivery: preview_delivery,
                        preview_total: preview_total,
                        discount_active: discount_active,
                        orderPreview: orderPreview
                    } only %}
                </aside>
            </div>
        </div>
    </section>

{% endblock %}
