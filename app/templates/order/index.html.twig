{% extends 'base.html.twig' %}

{% block title %}Commander {{ menu.title }}{% endblock %}

{% block body %}
    {% set previewPeople = orderForm.peopleCount.vars.value ?: menu.minPeople %}
    {% set previewSubtotal = menu.basePrice * previewPeople %}
    {% set previewDiscount = previewPeople >= (menu.minPeople + 5) ? (previewSubtotal * 0.10)|round(0, 'common') : 0 %}
    {% set previewDelivery = 0 %}
    {% set previewTotal = previewSubtotal - previewDiscount + previewDelivery %}

    {% include 'components/_hero.html.twig' with {
        title: 'Commander ' ~ menu.title,
        asset_url: menu.media ? menu.media.imgUrl : null,
        subtitle: (menu.basePrice / 100)|number_format(2, ',', ' ') ~ '€ par personne'
    } %}

    <section class="order-entry py-5">
        <div class="container">
            <div class="order-entry__topbar">
                <a href="{{ path('app_menu_show', { id: menu.id }) }}" class="order-entry__back">
                    <i class="bi bi-arrow-left me-2"></i>Retour au menu
                </a>
            </div>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger order-entry__flash" role="alert">{{ message }}</div>
            {% endfor %}

            <div class="order-entry__layout"
                {{ stimulus_controller('order-preview',{
                    basePrice: menu.basePrice,
                    minPeople: menu.minPeople,
                    stock:menu.stock
                }) }}>
                <div class="order-entry__main">
                    <article class="order-entry__panel order-entry__panel--menu">
                        <div class="card-body">
                            <div class="order-entry__eyebrow">Menu selectionne</div>

                            <div class="order-entry__menu">
                                <div class="order-entry__menu-media">
                                    {% if menu.media %}
                                        <img src="{{ menu.media.imgUrl }}" alt="{{ menu.media.altText }}">
                                    {% endif %}
                                </div>

                                <div class="order-entry__menu-content">
                                    <h2 class="order-entry__menu-title">{{ menu.title }}</h2>
                                    <p class="order-entry__menu-price">
                                        {{ (menu.basePrice / 100)|number_format(2, ',', ' ') }} € par personne
                                    </p>

                                    <div class="order-entry__badges">
                                        <span class="order-entry__badge">
                                            <i class="bi bi-people me-2"></i>{{ menu.minPeople }} pers. minimum
                                        </span>
                                        <span class="order-entry__badge order-entry__badge--accent">
                                            <i class="bi bi-box-seam me-2"></i>{{ menu.stock }} en stock
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>

                    <article class="order-entry__panel">
                        <details class="order-entry__details">
                            <summary class="order-entry__summary-toggle">
                                <span>
                                    <span class="order-entry__eyebrow">Profil client</span>
                                    <span class="order-entry__section-title order-entry__section-title--summary">Vos informations</span>
                                </span>
                                <i class="bi bi-chevron-down order-entry__summary-chevron" aria-hidden="true"></i>
                            </summary>

                            <div class="order-entry__customer-grid">
                                <div class="order-entry__customer-card">
                                    <span class="order-entry__customer-label">Nom</span>
                                    <strong class="order-entry__customer-value">{{ app.user.lastName }}</strong>
                                </div>
                                <div class="order-entry__customer-card">
                                    <span class="order-entry__customer-label">Prenom</span>
                                    <strong class="order-entry__customer-value">{{ app.user.firstName }}</strong>
                                </div>
                                <div class="order-entry__customer-card">
                                    <span class="order-entry__customer-label">Email</span>
                                    <strong class="order-entry__customer-value">{{ app.user.email }}</strong>
                                </div>
                                <div class="order-entry__customer-card">
                                    <span class="order-entry__customer-label">Telephone du compte</span>
                                    <strong class="order-entry__customer-value">{{ app.user.phone ?: '-' }}</strong>
                                </div>
                            </div>
                        </details>
                    </article>

                    <article class="order-entry__panel">
                        <div class="order-entry__section-head">
                            <div>
                                <div class="order-entry__eyebrow">Configuration</div>
                                <h2 class="order-entry__section-title">Votre commande</h2>
                            </div>
                            <i class="bi bi-basket2 order-entry__section-icon" aria-hidden="true"></i>
                        </div>

                        {{ form_start(orderForm, { attr: { class: 'order-entry__form', id: 'order-entry-form' } }) }}

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <div class="order-entry__block">
                                    {{ form_row(orderForm.peopleCount,
                                        { attr:
                                            stimulus_target('order-preview','peopleCount').toArray()|merge(
                                            stimulus_action('order-preview', 'refresh', 'input').toArray())
                                        }) }}
                                    <div class="order-entry__hint">Minimum requis : {{ menu.minPeople }} personnes</div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="order-entry__block">
                                    {{ form_row(orderForm.phone) }}
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="order-entry__block">
                                    {{ form_row(orderForm.serviceDate) }}
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="order-entry__block">
                                    {{ form_row(orderForm.serviceTime) }}
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="order-entry__block">
                                    {{ form_row(orderForm.distancekm,{
                                        attr: stimulus_target('order-preview','distanceKm').toArray()|merge(
                                            stimulus_action('order-preview', 'refresh', 'input').toArray())
                                    }) }}
                                    <div class="order-entry__hint">Estimation temporaire (TEMP) a renseigner uniquement pour les livraisons hors
                                        Bordeaux.
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="order-entry__subsection">
                                    <div>
                                        <div class="order-entry__eyebrow">Livraison</div>
                                        <h3 class="order-entry__subsection-title">Adresse de prestation</h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="order-entry__block">
                                    {{ form_row(orderForm.deliveryAddress) }}
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="order-entry__block">
                                    {{ form_row(orderForm.deliveryPostalCode) }}
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="order-entry__block">
                                    {{ form_row(orderForm.deliveryCity, {
                                        attr: stimulus_target('order-preview', 'deliveryCity').toArray()|merge(
                                            stimulus_action('order-preview', 'refresh', 'input').toArray())
                                    }) }}
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="order-entry__loan">
                                    <div class="order-entry__subsection order-entry__subsection--tight">
                                        <div>
                                            <div class="order-entry__eyebrow">Service complementaire</div>
                                            <h3 class="order-entry__subsection-title">Pret de materiel</h3>
                                        </div>
                                        <i class="bi bi-box2-heart order-entry__subsection-icon" aria-hidden="true"></i>
                                    </div>

                                    {{ form_row(orderForm.needEquipmentLoan, {
                                        attr: stimulus_target('order-preview', 'needEquipmentLoan').toArray()|merge(
                                            stimulus_action('order-preview', 'refresh', 'change').toArray())
                                    }) }}

                                    <div
                                        class="row g-3 mt-1 d-none"
                                        id="equipment-loan-fields"
                                        {{ stimulus_target('order-preview','equipmentLoanField') }}
                                    >
                                        <div class="col-12 col-md-6">
                                            {{ form_row(orderForm.equipmentLoanStartAt, {
                                                attr: stimulus_target('order-preview', 'equipmentLoanStartAt').toArray()|merge(
                                                    stimulus_action('order-preview', 'refresh', 'input').toArray())
                                            }) }}
                                        </div>
                                        <div class="col-12 col-md-6">
                                            {{ form_row(orderForm.equipmentLoanEndAt, {
                                                attr: stimulus_target('order-preview', 'equipmentLoanEndAt').toArray()|merge(
                                                    stimulus_action('order-preview', 'refresh', 'input').toArray())
                                            }) }}
                                        </div>
                                        <div class="col-12">
                                            {{ form_row(orderForm.equipmentLoanNote) }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="order-entry__block">
                                    {{ form_row(orderForm.note) }}
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="order-entry__conditions">
                                    <div class="order-entry__conditions-icon">
                                        <i class="bi bi-exclamation-triangle"></i>
                                    </div>
                                    <div>
                                        <h3 class="order-entry__conditions-title">Conditions importantes</h3>
                                        <ul class="order-entry__conditions-list mb-0">
                                            <li>Commande a confirmer au minimum 48h avant la prestation.</li>
                                            <li>Ce menu est disponible a partir de {{ menu.minPeople }} convives.</li>
                                            {% if menu.conditionInfo %}
                                                <li>{{ menu.conditionInfo }}</li>
                                            {% endif %}
                                            <li>Le montant final reste valide par l equipe avant confirmation definitive.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {{ form_end(orderForm) }}
                    </article>
                </div>

                <aside class="order-entry__sidebar">
                    <article class="order-entry__summary">
                        <div class="order-entry__eyebrow">Budget</div>
                        <h2 class="order-entry__summary-title">Recapitulatif</h2>

                        <div class="order-entry__summary-row">
                            <span {{ stimulus_target('order-preview', 'summaryPeople') }}>Menu ({{ previewPeople }} pers.)</span>
                            <strong {{ stimulus_target('order-preview', 'summarySubtotal') }}>
                                {{ (previewSubtotal / 100)|number_format(2, ',', ' ') }} €
                            </strong>
                        </div>

                        <div class="order-entry__summary-row">
                            <span>Remise</span>
                            <strong {{ stimulus_target('order-preview','summaryDiscount') }}>
                                {{ ((previewDiscount * -1) / 100)|number_format(2, ',', ' ') }}
                                €</strong>
                        </div>

                        <div class="order-entry__summary-row">
                            <span>Livraison</span>
                            <strong {{ stimulus_target('order-preview','deliveryPrice') }}>{{ (previewDelivery / 100)|number_format(2, ',', ' ') }}
                                €</strong>
                        </div>
                        <div class="order-entry__summary-row">
                            <span>Pret de materiel</span>
                            <strong {{ stimulus_target('order-preview', 'summaryLoan') }}>Aucun</strong>
                        </div>
                        <div class="order-entry__summary-divider"></div>

                        <div class="order-entry__summary-total">
                            <span>Total</span>
                            <strong {{ stimulus_target('order-preview','summaryTotal') }}>{{ (previewTotal / 100)|number_format(2, ',', ' ') }}
                                €</strong>
                        </div>

                        <div class="order-entry__summary-actions">
                            <button type="submit" form="order-entry-form" class="btn btn-primary btn-lg"
                                    disabled {{ stimulus_target('order-preview', 'submitButton') }}>
                                Confirmer la commande
                            </button>
                            <a href="{{ path('app_menu_show', { id: menu.id }) }}" class="btn btn-outline-primary btn-lg">
                                Retour au detail
                            </a>
                        </div>
                    </article>
                </aside>
            </div>


        </div>
    </section>

{% endblock %}
