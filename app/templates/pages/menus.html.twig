{# templates/pages/menus.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Menus - Liste de nos menus{% endblock %}

{% block body %}
    {# HERO #}
    <section class="pages-hero position-relative overflow-hidden">
        <div
            class="pages-hero__bg position-absolute top-0 start-0 w-100 h-100"
            style="
                background-image: url('{{ asset('build/images/hero/hero-menus.jpg') }}');
                background-size: cover;
                background-position: center;
                filter: brightness(0.6);
                ">
        </div>

        <div class="position-relative">
            <div class="container py-5 py-lg-6 pages-hero__content">
                <div class="row">
                    <div class="col-12 col-lg-8 mx-auto text-center text-light">
                        <h1 class="display-5 fw-bold mb-3">Tous nos menus</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# MENUS LIST #}
    {# BOUTTON FILTRE #}
    <section class="filters-section py-5">
        <div class="container">
            <h2 class="visually-hidden">Filtres des menus</h2>

            <button
                class="btn btn-success d-inline-flex align-items-center gap-2 px-4 py-3"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#filtersPanel"
                aria-expanded="true"
                aria-controls="filtersPanel"
            >
                <i class="bi bi-funnel"></i>
                Afficher les filtres
            </button>

            <div id="filtersPanel" class="collapse hiden mt-4">
                <div class="card shadow-sm border-0 filters-card">
                    <div class="card-body p-4">

                        <form class="filters-form">
                            <fieldset class="border-0 p-0 m-0 w-100 row g-4">
                                <legend class="visually-hidden">Options de filtrage</legend>

                            <div class="col-12 col-lg-4">
                                <label class="form-label small" for="priceMin">
                                    Prix minimum : <span id="priceMinValue">0€</span>
                                </label>
                                <input
                                    class="form-range"
                                    type="range"
                                    id="priceMin"
                                    min="0"
                                    max="100"
                                    step="1"
                                    value="0"
                                >
                            </div>

                            <div class="col-12 col-lg-4">
                                <label class="form-label small" for="priceMax">
                                    Prix maximum : <span id="priceMaxValue">100€</span>
                                </label>
                                <input
                                    class="form-range"
                                    type="range"
                                    id="priceMax"
                                    min="0"
                                    max="100"
                                    step="1"
                                    value="100"
                                >
                            </div>

                            <div class="col-12 col-lg-4">
                                <label class="form-label small" for="themeSelect">Thème</label>
                                <select class="form-select" id="themeSelect">
                                    <option value="">Tous les thèmes</option>
                                    <option value="gourmand">Gourmand</option>
                                    <option value="vege">Végétarien</option>
                                    <option value="premium">Premium</option>
                                </select>
                            </div>

                            <div class="col-12 col-lg-4">
                                <label class="form-label small" for="dietSelect">Régime</label>
                                <select class="form-select" id="dietSelect">
                                    <option value="">Tous les régimes</option>
                                    <option value="none">Sans restriction</option>
                                    <option value="glutenfree">Sans gluten</option>
                                    <option value="lactosefree">Sans lactose</option>
                                </select>
                            </div>

                            <div class="col-12 col-lg-4">
                                <label class="form-label small" for="peopleRange">
                                    Nombre de personnes : <span id="peopleValue">Tous</span>
                                </label>
                                <input
                                    class="form-range"
                                    type="range"
                                    id="peopleRange"
                                    min="0"
                                    max="10"
                                    step="1"
                                    value="0"
                                >
                                <div class="form-text">0 = Tous</div>
                            </div>

                                <div class="col-12 col-lg-4 d-flex align-items-end">
                                    <button type="reset" class="btn btn-outline-success w-100 py-2">
                                        Réinitialiser
                                    </button>
                                </div>

                            </fieldset>
                        </form>
                    </div>
                </div>
            </div>

            <p class="mt-3 mb-0">{{ menus is defined ? menus|length :'n/a' }} menus trouvés</p>

        </div>
    </section>

    {# CARD MENUS #}
    <section class="pb-5">
        <div class="container">
            <h2 class="visually-hidden">Liste des menus</h2>
            <div class="row row-gap-4" id="menu-cards">
                {% for menu in menus %}
                    {% set cover = null %}
                    {% for mm in menu.menuMedia %}
                        {% if mm.isCover and cover is null %}
                            {% set cover = mm %}
                        {% endif %}
                    {% endfor %}
                    {% set firstMedia = menu.menuMedia|first %}
                    {% set chosen = cover ?? firstMedia %}

                    <div class="col-12 col-md-6 col-lg-4 menu-card" data-category="entree">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                            {% if chosen %}
                                <img
                                    src="{{ chosen.media.imgUrl }}"
                                    class="card-img-top menu-card__img"
                                    alt="{{ chosen.media.altText }}"
                                >
                            {% else %}
                                <div class="menu-card__img bg-primary"></div>
                            {% endif %}

                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <h3 class="card-title h5 fw-bold mb-0">{{ menu.title }}</h3>
                                    <span class="fw-bold text-success">
                                        {{ (menu.basePrice / 100)|number_format(2, ',', ' ') }}€
                                    </span>
                                </div>

                                <p class="text-muted small mb-2">Minimum {{ menu.minPeople }} personnes</p>

                                {% if menu.description %}
                                    <p class="card-text text-muted mb-4">{{ menu.description }}</p>
                                {% endif %}

                                <a href="#" class="btn btn-outline-success mt-auto align-self-center px-4">
                                    Voir détail
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {#  IMFORMATION PRATIQUE #}
    <section class="py-5">
        <div class="container">
            <div class="card shadow-sm border-0 rounded-4 p-4 p-lg-5">
                <h2 class="h3 text-center">Informations pratiques</h2>

                <div class="row">
                    <div class="col-md-4 text-start">
                        <h3 class="h5 text-primary">Allergéne</h3>
                        <p class="small">Nos plats peuvent contenir des allergènes.<br>
                            N'hésitez pas à nous contacter pour plus d'informations.
                        </p>
                    </div>
                    <div class="col-md-4 text-center">
                        <h3 class="h5 text-primary">Réservation</h3>
                        <p class="small">Nous recommandons de commander 48 à 72h à l'avance selon le menu choisi.
                        </p>
                    </div>
                    <div class="col-md-4 text-start text-lg-end">
                        <h3 class="h5 text-primary">Horaires</h3>
                        <p class="small">Midi : 12:30-14:30</p>
                        <p class="small">Soir : 18:30-22:30</p>
                        <p class="small">Fermé le lundi</p>
                    </div>


                </div>

            </div>
        </div>
    </section>

{% endblock %}
