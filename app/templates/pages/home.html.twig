{# templates/pages/home.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accueil - Vite & Gourmand{% endblock %}

{% block body %}

    {# HERO #}
    <section class="home-hero position-relative overflow-hidden">
        <div
            class="home-hero__bg position-absolute top-0 start-0 w-100 h-100"
            style="
                background-image: url('{{ asset('build/images/hero/hero-home.jpg') }}');
                background-size: cover;
                background-position: center;
                filter: brightness(0.6);
                ">
        </div>

        <div class="position-relative">
            <div class="container py-5 py-lg-6 home-hero__content">
                <div class="row">
                    <div class="col-12 col-lg-8 mx-auto text-center text-light">
                        <h1 class="display-5 fw-bold mb-3">Vite &amp; Gourmand</h1>
                        <p class="lead mb-4">
                            Traiteur à Bordeaux - Une cuisine passionnée
                        </p>

                        <a href="{{ path('app_menus') }}" class="btn btn-primary px-4 py-2 fw-semibold">
                            Découvrir nos menus
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# QUI SOMMES-NOUS #}
    <section class="py-5">
        <div class="container">
            <h2 class="h3 fw-bold text-center mb-5">Qui sommes-nous ?</h2>

            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-12 col-lg-6">
                    <div class="ratio ratio-4x3 rounded-4 overflow-hidden shadow-sm">
                        <img
                            src="{{ asset('build/images/home/about-chef.jpg') }}"
                            class="w-100 h-100 object-fit-cover"
                            alt="Un chef en cuisine préparant un plat">
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <h3 class="h2 fw-bold text-primary mb-3">Une passion familiale</h3>

                    <p class="mb-3">
                        Julie et José passionnés de gastronomie, ont fondé Vite &amp; Gourmand à Bordeaux avec une vision simple :
                        rendre la cuisine de qualité accessible à tous pour vos évènements.
                    </p>

                    <p class="mb-3">
                        Forts de leur expérience dans la restauration, ils proposent des menus variés et personnalisables,
                        préparés avec des produits frais et locaux.
                    </p>

                    <p class="mb-0">
                        Que ce soit pour un évènement d’entreprise, une fête familiale ou un repas entre amis,
                        notre équipe met tout en œuvre pour satisfaire vos papilles et vos convives.
                    </p>
                </div>
            </div>
        </div>
    </section>

    {# NOTRE ENGAGEMENT #}
    <section class="pb-5">
        <div class="container ">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">
                    <h2 class="h3 fw-bold text-center text-primary mb-4">Notre engagement professionnel</h2>

                    <div class="row text-center g-4">
                        <div class="col-12 col-md-4">
                            <div class="mb-3">
                <span class="h2 d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-light"
                      style="width:56px;height:56px;">
                  ✓
                </span>
                            </div>
                            <h3 class="h5 fw-bold mb-2">Qualité garantie</h3>
                            <p class="small text-muted mb-0">
                                Produits frais et locaux, préparation soignée le jour même
                            </p>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="mb-3">
                <span class="h2 d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-light"
                      style="width:56px;height:56px;">
                  ⏱
                </span>
                            </div>
                            <h3 class="h5 fw-bold mb-2">Ponctualité</h3>
                            <p class="small text-muted mb-0">
                                Livraison à l’heure convenue, respect des délais
                            </p>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="mb-3">
                <span class="h2 d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-light"
                      style="width:56px;height:56px;">
                  ♥
                </span>
                            </div>
                            <h3 class="h5 fw-bold mb-2">Service personnalisé</h3>
                            <p class="small text-muted mb-0">
                                À votre écoute pour adapter nos menus à vos besoins
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# TODO: avis clients affichés en clair pour le moment (pas encore liés à la base / modération) #}
    {# AVIS CLIENTS #}
    <section class="py-5 ">
        <div class="container">
            <h2 class="h3 fw-bold text-center mb-5">Ce que nos clients disent de nous</h2>

            <div class="row g-4 ">
                <div class="col-12 col-md-4 ">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <span class="h2 d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-light" style="width:56px;height:56px;">

                            </span>
                            <div class="mb-2 text-warning">★★★★★</div>
                            <p class="small mb-4">
                                “Excellent service ! Les plats étaient délicieux et la livraison très professionnelle.
                                Je recommande vivement !”
                            </p>
                            <div class="small text-muted">
                                <div class="fw-semibold">SophieM.</div>
                                <div>16/01/2025</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <span class="h2 d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-light" style="width:56px;height:56px;">

                            </span>

                            <div class="mb-2 text-warning">★★★★☆</div>
                            <p class="small mb-4">
                                “Très bonne prestation, qualité au rendez-vous. Juste un petit retard sur la livraison,
                                mais rien de grave.”
                            </p>
                            <div class="small text-muted">
                                <div class="fw-semibold">SophieM.</div>
                                <div>10/01/2025</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <span class="h2 d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-light" style="width:56px;height:56px;">

                            </span>

                            <div class="mb-2 text-warning">★★★★★</div>
                            <p class="small mb-4">
                                “Parfait pour notre évènement d’entreprise ! Tous nos invités ont adoré.
                                Merci à Julie et José !”
                            </p>
                            <div class="small text-muted">
                                <div class="fw-semibold">SophieM.</div>
                                <div>05/01/2025</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    {# CTA PRÊT À COMMANDER #}
    <section class="py-5 bg-primary text-light">
        <div class="container text-center">
            <h2 class="h3 fw-bold mb-3">Prêt à commander ?</h2>
            <p class="mb-4 opacity-75">
                Découvrez nos menus et passez commande en quelques clics pour votre prochain évènement
            </p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="{{ path('app_menus') }}" class="btn btn-outline-light px-4">
                    Voir nos menus
                </a>
                <a href="{{ path('app_contact') }}" class="btn btn-light px-4 fw-semibold">
                    Nous contacter
                </a>
            </div>
        </div>
    </section>

{% endblock %}
