{# templates/menu/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
    {{ menu.title }}
{% endblock %}
{% block body %}
    {# HERO #}
    {% include 'components/_hero.html.twig' with  {
        'title': menu.title,
        'asset_url': menu.media.imgUrl,
        'subtitle': (menu.basePrice / 100)|number_format(2, ',', ' ') ~ '€ par personne'
    } %}


    <section class="menu-show py-5 container">
        <div class="menu-show__intro">
            <a href="{{ path('app_menu_index') }}" class="menu-show__back d-inline-flex align-items-center mb-4">
                <i class="bi bi-arrow-left me-2"></i>Retour aux menus
            </a>
            <h2 class="h4">
                Description
            </h2>
            <p class="text-muted">
                {{ menu.description }}
            </p>
        </div>
        {% set metas = [
            {title: 'Thème',
                value: menu.theme ? menu.theme.name : 'Pas de thème enregistré'},
            {title: 'Régime',
                value: menu.diet ? menu.diet.name : 'Pas de régime enregistré'},
            {title: 'Nombre minimum de personnes',
                value: menu.minPeople is not null ? menu.minPeople : 'Pas de minimum de personnes enregistré'},
            {title: 'Stock',
                value: menu.stock is not null ? menu.stock : 'Pas de stock enregistré'},
        ] %}
        <div class="row g-3 menu-show__meta">
            {% for meta in metas %}
                {% include 'menu/components/_meta_card.html.twig' with meta only %}
            {% endfor %}
        </div>

        {% if menu.conditionInfo %}
            <div class="menu-show__alert menu-show__alert--info mt-3">
                <div class="fw-semibold mb-1">Conditions</div>
                <p class="small mb-0">{{ menu.conditionInfo }}</p>
            </div>
        {% endif %}

        {% if allergens is defined and allergens is not empty %}
            <div class="menu-show__alert menu-show__alert--danger mt-3">
                <div class="fw-semibold mb-1">
                    <i class="bi bi-exclamation-circle me-2"></i>Allergènes présents
                </div>
                <p class="small mb-0"> {% for allergen in allergens %} {{ allergen.name }}, {% endfor %} </p>
            </div>

        {% endif %}

        <div class="col-12 col-lg-7">
            <h2 class="h4">
                Composition du menu
            </h2>
            {% for dishType in dishesByType %}
                <div class="menu-show__panel mt-3">
                    <h3 class="menu-show__panel-title">{{ dishType.name }}</h3>
                    <ul class="menu-show__list">
                        {% for dish in dishType.dishes %}
                            <li>{{ dish.name }}</li>
                        {% else %}
                            <li class="text-muted">Aucun élément</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>

        <div class="menu-show__cta mt-5 text-center">
            <h3 class="h5 mb-2">Prêt à commander ce menu ?</h3>
            <p class="text-muted small mb-3">Connectez-vous ou créez un compte pour commander ce menu</p>
            {% if menu.stock is not null and menu.stock > 0 %}
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a class="btn btn-primary" href="{{ path('app_order_new', {id: menu.id}) }}">Commander</a>
                    <a class="btn btn-outline-primary" href="{{ path('app_contact_index') }}">Une question ?</a>
                </div>
            {% else %}
                <div class="menu-card__alert menu-card__alert--danger mt-auto align-self-center px-4 py-2">
                    <i class="bi bi-x-circle me-2"></i>Pas de stock disponible
                </div>
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-3">
                    <a class="btn btn-outline-primary" href="{{ path('app_contact_index') }}">Une question ?</a>
                </div>
            {% endif %}
        </div>


    </section>


{% endblock %}

