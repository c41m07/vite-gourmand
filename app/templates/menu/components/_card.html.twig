{# templates/menu/components/_card.html.twig #}
<div class="col-12 col-md-6 col-lg-4 menu-card" data-menu-target="list">
    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
        {% if menu.media %}
            <img
                src="{{ menu.media.imgUrl }}"
                class="card-img-top menu-card__img"
                alt="{{ menu.media.altText }}"
            >
        {% else %}
            <div class="menu-card__img bg-primary"></div>
        {% endif %}

        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <h3 class="card-title h5 fw-bold mb-0">{{ menu.title }}</h3>
                <span class="fw-bold text-success">
                    {{ (menu.basePrice / 100)|number_format(2, ',', ' ') }} €
                </span>
            </div>

            <div class="menu-card__labels mt-3 mb-2">
                <span class="menu-card__label">
                    Min. {{ menu.minPeople }} pers.
                </span>
                <span class="menu-card__label menu-card__label--stock {{ menu.stock > 0 ? 'menu-card__label--success' : 'menu-card__label--danger' }}">
                    Stock : {{ menu.stock }}
                </span>
            </div>

            {% if menu.description %}
                <p class="card-text text-muted mb-4">{{ menu.description }}</p>
            {% endif %}

            {% if menu.stock > 0 %}
                <div class="menu-card__actions mt-auto">
                    <a href="{{ path('app_menu_show', {'id': menu.id}) }}" class="btn btn-outline-success">
                        Voir le détail
                    </a>
                    <a href="{{ path('app_order_new', { id: menu.id }) }}" class="btn btn-success">
                        Commander
                    </a>
                </div>
            {% else %}
                <div class="menu-card__alert menu-card__alert--danger mt-auto align-self-center px-4 py-2">
                    <i class="bi bi-x-circle me-2"></i>Pas de stock disponible
                </div>
            {% endif %}
        </div>
    </div>
</div>
