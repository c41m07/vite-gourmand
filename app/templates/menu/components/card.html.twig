{# templates/menu/components/card.html.twig #}
<div class="col-12 col-md-6 col-lg-4 menu-card" data-menu-target="list">
    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
        {% if menu.media %}
            <img
                src="{{ menu.media.imgUrl }}"
                class="card-img-top menu-card__img"
                alt="{{ menu.media.altText }}"
            >
        {% else %}
            <div class="menu-card__img bg-primary"></div>
        {% endif %}

        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <h3 class="card-title h5 fw-bold mb-0">{{ menu.title }}</h3>
                <span class="fw-bold text-success">
                                        {{ (menu.basePrice / 100)|number_format(2, ',', ' ') }}€
                                    </span>
            </div>

            <p class="text-muted small mb-2">Minimum {{ menu.minPeople }} personnes</p>

            {% if menu.description %}
                <p class="card-text text-muted mb-4">{{ menu.description }}</p>
            {% endif %}



            {% if menu.stock > 0 %}
                <a href="{{ path('app_menu_show', {'id': menu.id}) }}" class="btn btn-outline-success mt-auto align-self-center px-4">
                    Voir détail
                </a>
            {% else %}
                <div class="menu-card__alert menu-card__alert--danger mt-auto align-self-center px-4 py-2">
                    <i class="bi bi-x-circle me-2"></i>Pas de stock disponible
                </div>
            {% endif %}
        </div>
    </div>
</div>
