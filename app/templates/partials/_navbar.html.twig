{# templates/partials/_navbar.html.twig #}
{% set currentRoute = app.request.attributes.get('_route') %}


<nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom shadow-sm vg-navbar " aria-label="Navigation principale">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">Vite & Gourmand</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                aria-controls="mainNavbar" aria-expanded="false" aria-label="Ouvrir le menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 nav-underline">
                <li class="nav-item">
                    <a class="nav-link {{ currentRoute == 'app_home' ? 'active' : '' }}" {{ currentRoute == 'app_home' ? 'aria-current="page"' :
                    '' }} href="{{ path('app_home') }}">Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ currentRoute == 'app_menus' ? 'active' : '' }}" {{ currentRoute == 'app_menus' ? 'aria-current="page"'
                    : '' }} href="{{ path('app_menus') }}">Tous les menus</a>
                </li>
                <li class="nav-item">
                    {# TODO créé la route connexion et remplacer # #}
                    <a class="nav-link {{ currentRoute == '#' ? 'active' : '' }}" {{ currentRoute == '#' ? 'aria-current="page"' : '' }}
                       href="#">Connexion</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ currentRoute == 'app_contact' ? 'active' : '' }}" {{ currentRoute == 'app_contact' ?
                    'aria-current="page"' : '' }} href="{{ path('app_contact') }}">Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
