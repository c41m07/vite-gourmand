{# templates/partials/underconstruct.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Page en construction - Vite & Gourmand{% endblock %}

{% block body %}
    {% include 'components/hero.html.twig' with {
        'title': 'Page en construction',
        'subtitle': 'Nous arrivons bientôt',
        'background': '#8a5a2b'
    } %}

    <section class="py-5" aria-labelledby="underconstruct-title">
        <div class="container">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    <h2 id="underconstruct-title" class="h3 fw-bold mb-3">Merci pour votre patience</h2>
                    <p class="text-muted mb-4">
                        Cette page est en préparation. Revenez nous voir très vite, nous finalisons les derniers détails.
                    </p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a class="btn btn-primary px-4" href="{{ path('app_home') }}">Retour à l'accueil</a>
                        <a class="btn btn-outline-secondary px-4" href="{{ path('app_contact_index') }}">Nous contacter</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
